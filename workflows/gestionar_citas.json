    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Obtener datos del nodo anterior\nconst fechaInicioStr = $json.fecha_inicio;\nconst tramite = ($json.tipo_tramite || '').toLowerCase();\n\n// Determinar la fecha de inicio en formato Date nativo\nlet inicio = fechaInicioStr ? new Date(fechaInicioStr) : new Date();\nif (isNaN(inicio.getTime())) {\n  inicio = new Date();\n}\n\n// Calcular minutos según la regla del trámite\nlet minutos = 45; // Por defecto\n\nif (tramite.includes('nacionalidad') || tramite.includes('agrupaci')) {\n  minutos = 60;\n} else if (tramite.includes('renovaci') || tramite.includes('nie')) {\n  minutos = 30;\n} else if (tramite.includes('consulta') || tramite.includes('asesor')) {\n  minutos = 45;\n}\n\n// Calcular fecha final sumando los milisegundos de los minutos\nconst fin = new Date(inicio.getTime() + minutos * 60 * 1000);\n\nreturn {\n  json: {\n    ...$json,\n    fecha_inicio_iso: inicio.toISOString(),\n    fecha_fin_iso: fin.toISOString()\n  }\n};"
      },
