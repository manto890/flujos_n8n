        "parameters": {
          "operation": "executeQuery",
          "query": "SELECT d.nombre_documento, d.ruta_archivo \nFROM tramites AS t\nJOIN documentos d ON t.pasaporte_nie = d.pasaporte_nie\nWHERE t.pasaporte_nie = '{{ $json.pasaporte_nie }}';",
